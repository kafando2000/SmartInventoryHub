## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
Hubserver/[Dd]ebug/
Hubserver/[Dd]ebugPublic/
Hubserver/[Rr]elease/
Hubserver/[Rr]eleases/

HubClient/[Dd]ebug/
HubClient/[Dd]ebugPublic/
HubClient/[Rr]elease/
HubClient/[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
Hubserver/[Bb]in/
Hubserver/[Oo]bj/
Hubserver/[Ll]og/
Hubserver/[Ll]ogs/

HubClient/[Bb]in/
HubClient/[Oo]bj/
HubClient/[Ll]og/
HubClient/[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

#tailwindcss
**/node_modules